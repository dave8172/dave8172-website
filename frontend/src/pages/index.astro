---
import BaseLayout from "../layouts/BaseLayout.astro";
import RandomColor from "../components/RandomColor.astro";
import ProjectCard from "../components/ProjectCard.astro";
import Shelf from "../components/Shelf.astro";
import { shelveProjects, toCardProps } from "../lib/shelves";
import { getCollection } from "astro:content";

// Three shelves and nothing else. Everything still lives on this page — there
// is no separate projects index — it just no longer costs four screens of
// scrolling to get past it.
const shelves = shelveProjects(await getCollection("projects"));

// All of them, not the three most recent: the blog shelf is the blog, and a
// rail holds as many as it is given.
const posts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const GITHUB = "https://github.com/dave8172";
const X = "https://x.com/dave8172";

const TITLE = "Dave — AI engineering and automation projects";
const DESCRIPTION =
  "Open-source AI tooling, agent safety gates, eval harnesses and model accuracy benchmarks, plus Excel, Sheets and Python automation built for real businesses.";

const abs = (path: string) => new URL(path, Astro.site).href;

// Structured data, built from the same arrays the page renders, so the machine
// index and the visible index cannot disagree. An answer engine reading this
// gets every project's name, description and URL without executing anything.
const person = {
  "@type": "Person",
  "@id": abs("/#person"),
  name: "Dave",
  url: abs("/"),
  sameAs: [GITHUB, X],
};

const projectItem = (project: ReturnType<typeof toCardProps>, repo?: string) => ({
  "@type": repo ? "SoftwareSourceCode" : "CreativeWork",
  name: project.title,
  description: project.description,
  url: abs(project.href),
  ...(repo ? { codeRepository: repo } : {}),
  author: { "@id": abs("/#person") },
});

const listOf = (name: string, description: string, items: object[]) => ({
  "@type": "ItemList",
  name,
  description,
  numberOfItems: items.length,
  itemListElement: items.map((item, i) => ({
    "@type": "ListItem",
    position: i + 1,
    item,
  })),
});

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "@id": abs("/#home"),
  url: abs("/"),
  name: TITLE,
  description: DESCRIPTION,
  mainEntity: person,
  hasPart: [
    ...shelves.map(({ shelf, items }) =>
      listOf(
        shelf.label,
        shelf.note,
        items.map((project) => projectItem(toCardProps(project), project.data.repo)),
      ),
    ),
    listOf(
      "Blog",
      "Benchmarks and teardowns from real builds.",
      posts.map((post) => ({
        "@type": "BlogPosting",
        headline: post.data.title,
        description: post.data.description,
        url: abs(`/blog/${post.id}`),
        datePublished: post.data.date.toISOString().slice(0, 10),
        author: { "@id": abs("/#person") },
      })),
    ),
  ],
};
---

<BaseLayout width="wide" title={TITLE} description={DESCRIPTION} schema={schema}>
  <section class="hero">
    <h1><RandomColor>Curious.</RandomColor></h1>
  </section>

  <div class="shelves">
    {shelves.map(({ shelf, items }, i) => (
      <Shelf id={shelf.id} label={shelf.label} note={shelf.note} count={items.length} open={i === 0}>
        {items.map((project) => <ProjectCard {...toCardProps(project)} />)}
      </Shelf>
    ))}

    <Shelf
      id="blog"
      label="Blog"
      note="Benchmarks and teardowns — what broke, what it cost, and the number that settled it."
      count={posts.length}
      href="/blog"
      linkLabel="All posts"
    >
      {posts.map((post) => (
        <ProjectCard
          href={`/blog/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          tags={post.data.tags}
          badge="Article"
        />
      ))}
    </Shelf>
  </div>

  <section class="connect">
    <h2 class="connect-label"><RandomColor>Elsewhere</RandomColor></h2>

    <div class="connect-links">
    <a class="connect-link" href={GITHUB} target="_blank" rel="me noopener noreferrer">
      <svg width="17" height="17" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
      </svg>
      GitHub
    </a>

    <a class="connect-link" href={X} target="_blank" rel="me noopener noreferrer">
      <svg width="15" height="15" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
        <path d="M12.6 0h2.45l-5.35 6.12L16 16h-4.93l-3.86-5.05L2.79 16H.34l5.72-6.54L0 0h5.06l3.49 4.61L12.6 0Zm-.86 14.54h1.36L4.32 1.38H2.87l8.87 13.16Z" />
      </svg>
      X
    </a>
    </div>
  </section>
</BaseLayout>

<script>
  // Progressive enhancement, and only that: the rails scroll by swipe, trackpad,
  // shift-wheel and arrow key with this file absent. All it adds is the pair of
  // desktop arrow buttons, which stay hidden until it has confirmed the rail
  // genuinely overflows — a button that scrolls nothing is worse than no button.
  document.documentElement.classList.add("has-js");

  const wraps = Array.from(document.querySelectorAll<HTMLElement>(".rail-wrap"));
  const smooth = !matchMedia("(prefers-reduced-motion: reduce)").matches;

  // A closed <details> has a zero-width rail, so every measurement is deferred
  // until the panel it lives in is actually open.
  function sync(wrap: HTMLElement) {
    const rail = wrap.querySelector<HTMLElement>(".rail");
    if (!rail) return;
    const max = rail.scrollWidth - rail.clientWidth;
    wrap.dataset.overflow = String(max > 8);
    wrap.dataset.atStart = String(rail.scrollLeft <= 8);
    wrap.dataset.atEnd = String(rail.scrollLeft >= max - 8);
  }

  for (const wrap of wraps) {
    const rail = wrap.querySelector<HTMLElement>(".rail");
    if (!rail) continue;

    rail.addEventListener("scroll", () => sync(wrap), { passive: true });

    for (const btn of wrap.querySelectorAll<HTMLButtonElement>(".rail-nav")) {
      btn.addEventListener("click", () => {
        const card = rail.firstElementChild;
        const gap = parseFloat(getComputedStyle(rail).columnGap) || 20;
        const step = card ? card.getBoundingClientRect().width + gap : rail.clientWidth * 0.8;
        rail.scrollBy({ left: Number(btn.dataset.dir) * step, behavior: smooth ? "smooth" : "auto" });
      });
    }

    sync(wrap);
  }

  for (const shelf of document.querySelectorAll<HTMLElement>(".shelf")) {
    shelf.addEventListener("toggle", () => {
      for (const wrap of shelf.querySelectorAll<HTMLElement>(".rail-wrap")) sync(wrap);
    });
  }

  addEventListener("resize", () => wraps.forEach(sync), { passive: true });
</script>
