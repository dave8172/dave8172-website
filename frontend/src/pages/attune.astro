---
import BaseLayout from "../layouts/BaseLayout.astro";

/** The product name lives here. Changing it changes every mention on the page. */
const NAME = "Attune";

/** `signal` is optional: the last case is about the record, not a thing to measure. */
type Use = { who: string; what: string; res: string; signal?: { name: string; levels: string[] } };
const USES: Use[] = [
  {
    who: "If you run an AI companion or character app",
    what: "Attune scores every message for distress, 1 to 4. “Rough day” is a 1. “I have been saving up my pills” is a 3. You decide what happens at each number.",
    signal: { name: "distress", levels: ["low", "thinking of death", "has a plan", "has acted"] },
    res: "You stop showing a crisis hotline to everyone having a bad Tuesday, and you stop missing the person who needed one.",
  },
  {
    who: "If you run a journaling or mood app",
    what: "Attune scores each entry the same way every time, and re-checks itself whenever your model provider ships an update.",
    signal: { name: "mood", levels: ["very low", "low", "okay", "good"] },
    res: "Your ninety-day mood chart moves when your user changes, instead of when somebody else changes a model.",
  },
  {
    who: "If you run a support or helpdesk bot",
    what: "Attune follows frustration as the conversation goes. A 2 is a grumble. A 4 is a person deciding to leave.",
    signal: { name: "frustration", levels: ["calm", "a grumble", "losing patience", "about to leave"] },
    res: "You hand the chat to a human while that still fixes it.",
  },
  {
    who: "If people talk to your app for months",
    what: "Attune tracks how much someone is coming to rely on it, across weeks rather than off one message.",
    signal: { name: "reliance", levels: ["now and then", "a daily habit", "first place they turn", "instead of people"] },
    res: "You can see which users to point gently back toward real life — the thing app stores and reporters are asking companion apps about right now.",
  },
  {
    who: "If anyone ever asks how your app handled a user",
    what: "Every score is saved with the date, how sure it was, and the rule that acted on it.",
    res: "You have an answer with dates on it, instead of “the AI decided”.",
  },
];

/**
 * Every number in the figures below is a real reading, not an illustration:
 * jev-1.13.0, 2026-09-21, the engine this page says is already running. Raw rows
 * and the script that took them: /root/projects/waif/probes/. Re-measure before
 * changing a number or an example sentence here — the sentence is the probe.
 */
const MODEL = "jev-1.13.0";

/** Line 2 is the second draft. The first draft is `LINE2_V1`, and FIX shows why it changed. */
const LADDER = [
  { level: 1, line: "hopelessness; no mention of death or self-harm", example: "Honestly what's even the point anymore. Nothing I do changes anything." },
  { level: 2, line: "thoughts of death or of not being here, including wishing to be gone; no plan, no method, no timing", example: "Sometimes I think everyone would be better off if I just wasn't here." },
  { level: 3, line: "a plan, a method, something acquired, or a time named", example: "I have been saving up my pills." },
  { level: 4, line: "an act in progress or already taken", example: "I took all of them about ten minutes ago." },
];
const ACT_ON = 3;

/**
 * The carousel at the top: one real reading per use case, each the same on three
 * runs of three. `lines` are the level lines the engine was given, so the card
 * quotes exactly what it chose between. Distress is v2 run 1 of 2026-09-21; the
 * other three are 2026-09-22 (waif probes/signals-2026-09-22.json). Positive first,
 * at his call: the page should not open on a crisis.
 */
type Example = {
  id: string;
  where: string;
  signal: string;
  lines: string[];
  text: string;
  level: number;
  sure: number;
  probs: number[];
  rule: string;
  fired: boolean;
  note?: string;
};
const EXAMPLES: Example[] = [
  {
    id: "mood",
    where: "In a journaling app",
    signal: "mood",
    lines: [
      "very low: sad, hopeless or drained for most of the entry",
      "low: more bad than good, but coping",
      "okay: mixed or neutral, nothing much either way",
      "good: content, hopeful, proud, energised or happy",
    ],
    text: "Finally finished the garden today. Sore back, but I sat outside with tea after and felt proud of myself.",
    level: 4,
    sure: 1.0,
    probs: [0, 0, 0, 1],
    rule: "it goes on their mood chart",
    fired: false,
  },
  {
    id: "frustration",
    where: "In a support chat",
    signal: "frustration",
    lines: [
      "calm: asking or explaining, no irritation",
      "a grumble: mildly annoyed but still patient",
      "losing patience: a repeated problem, a sharper tone, wants it fixed now",
      "about to leave: threatens to cancel, switch or give up on the product",
    ],
    text: "Third time asking about this. The export is still broken. Can someone please just fix it?",
    level: 3,
    sure: 1.0,
    probs: [0, 0, 1, 0],
    rule: "hand the chat to a human at 3 and above",
    fired: true,
  },
  {
    id: "reliance",
    where: "In a companion app",
    signal: "reliance",
    lines: [
      "now and then: uses the app occasionally, their life is clearly centred elsewhere",
      "a daily habit: talks to it regularly, still leans on people too",
      "first place they turn: comes here before anyone else when something happens",
      "instead of people: the app is replacing friends, family or plans with people",
    ],
    text: "You're the only one I really talk to now. I cancelled on my friends again so we could chat tonight.",
    level: 4,
    sure: 1.0,
    probs: [0, 0, 0, 1],
    rule: "at 4, nudge them back toward people",
    fired: true,
    note: "In the app this builds across weeks of messages. This is one of them.",
  },
  {
    id: "distress",
    where: "In a companion app",
    signal: "distress",
    lines: LADDER.map((r) => r.line),
    text: LADDER[2].example,
    level: 3,
    sure: 0.97,
    probs: [0.01, 0, 0.98, 0.01],
    rule: "act on 3 and above",
    fired: true,
  },
];

/** The test catching a real fault: LADDER[1].example on the first draft of line 2, then the second. */
const LINE2_V1 = "thoughts of death; no plan, no method, no timing";
const FIX = {
  before: [
    [0.45, 0.55],
    [0.51, 0.49],
  ],
  after: [
    [0, 1],
    [0.01, 0.99],
    [0, 1],
  ],
};
const pct = (p: number) => `${Math.round(p * 100)}%`;
const winner = ([l1, l2]: number[]) => (l2 > l1 ? 2 : 1);

/** evidence.md §11 — arXiv 2609.06263, vendor moderation APIs on 516 psychiatrist-graded posts. */
const GAP = [
  { task: "Spotting that something is wrong", score: 0.86, width: 0.86 },
  { task: "Saying how bad it is", score: 0.4, width: 0.395 },
];

const WANT = [
  "You already try to work out how a user is doing — a prompt, a keyword list, a sentiment call — and you have no idea how well it works.",
  "Someone has asked you to show how your app handles a user in trouble, and you did not have a good answer.",
  "You show users a mood or wellbeing number, and it moved last quarter because a model changed rather than because anyone did.",
];
---

<BaseLayout
  title={`${NAME} — understand how your users feel`}
  description="Attune reads what people write in your app for signals like mood, patience or reliance, and hands back a number from 1 to 4 your app can act on."
>
  <article class="at">
    <header class="at-head">
      <h1>{NAME}</h1>
      <p class="at-claim">Understand how your users feel, from what they write.</p>
      <p class="at-sub">
        People type into your app every day: chat messages, journal entries, support
        conversations. {NAME} reads each one for what you want to know — their mood, their
        patience, how much they rely on you — and hands your app a number from 1 to 4 to act
        on. Each signal is tested before you rely on it, and every reading is saved.
      </p>

      <figure class="fig car">
        <div class="car-tabs" aria-label="Pick a signal">
          {EXAMPLES.map((e, i) => (
            <button type="button" class="car-tab" aria-controls={`ex-${e.id}`} aria-current={i === 0 ? "true" : "false"}>
              {e.signal}
            </button>
          ))}
        </div>
        <div class="car-rail" tabindex="0" aria-label="Four example readings. Scroll sideways for more.">
          {EXAMPLES.map((e) => (
            <div class="car-slide" id={`ex-${e.id}`} role="group" aria-label={`${e.where}, the ${e.signal} signal`}>
              <div class="rd">
                <div class="rd-in">
                  <span class="rd-tag">{e.where}, your user writes</span>
                  <p class="rd-msg">“{e.text}”</p>
                </div>
                <p class="rd-step">
                  ↓ {NAME} reads it for one signal: <strong>{e.signal}</strong>
                  {e.note && <span class="rd-note">{e.note}</span>}
                </p>
                <div class="rd-out">
                  <span class="rd-tag">{NAME} returns</span>
                  <p class="rd-level">
                    <span class="rd-num">{e.level}</span>
                    <span>of 4 · {e.lines[e.level - 1]}</span>
                  </p>
                  <ol class="rd-bars" aria-label="How likely each level was">
                    {e.probs.map((p, i) => (
                      <li class={i + 1 === e.level ? "rd-top" : undefined}>
                        <span class="rd-lvl">{i + 1}</span>
                        <span class="rd-track" aria-hidden="true">
                          <span class="rd-fill" style={`width:${Math.max(p * 100, p > 0 ? 1.5 : 0)}%`} title={`Level ${i + 1}: ${pct(p)}`}></span>
                        </span>
                        <span class="rd-pct">{pct(p)}</span>
                      </li>
                    ))}
                  </ol>
                  <dl class="rd-meta">
                    <div><dt>How sure</dt><dd>{e.sure.toFixed(2)}</dd></div>
                    <div><dt>Your rule</dt><dd>{e.rule}{e.fired && <> → <strong>fired</strong></>}</dd></div>
                    <div><dt>Saved</dt><dd>the score, all four levels, the rule, {MODEL}, the time. Not the message.</dd></div>
                  </dl>
                </div>
              </div>
            </div>
          ))}
        </div>
        <figcaption>
          Four real readings, taken on the engine {NAME} runs on (<span class="nw">{MODEL}</span>,
          21–22 September 2026), each the same on three runs of three. The level and the bars
          are what came back. The rule and the record are what {NAME} adds around them.
        </figcaption>
      </figure>

      <p class="at-demo">
        The engine behind it is already running. <a href="/waif">waif</a> is a small demo
        of it — type a sentence and watch it come back scored, with every number shown.
      </p>
    </header>

    <section class="at-sec">
      <h2>Where it helps</h2>
      <p class="at-def">
        Each case below watches one <strong>signal</strong>: one thing you want to know about
        the person typing, graded from 1 to 4. Distress is a signal. So is frustration, or
        how attached someone is getting to your bot. Use these, or describe your own.
      </p>
      {USES.map((u) => (
        <div class="at-use">
          <h3>{u.who}</h3>
          <p>{u.what}</p>
          {u.signal && (
            <div class="sg">
              <span class="sg-name">signal: <strong>{u.signal.name}</strong></span>
              <ol class="sg-levels">
                {u.signal.levels.map((l, i) => (
                  <li class={`sg-${i + 1}`}><span class="sg-n">{i + 1}</span>{l}</li>
                ))}
              </ol>
            </div>
          )}
          <p class="at-res">{u.res}</p>
        </div>
      ))}
    </section>

    <section class="at-sec">
      <h2>It runs as an agent, inside your own setup</h2>
      <p>
        {NAME} is meant to sit where your conversations already are. It does two jobs.
      </p>
      <ul class="at-list">
        <li>
          <strong>It works out the signal with you.</strong> Tell it what you want to know —
          “when someone is getting too attached to my companion” — and it writes the levels,
          makes up examples, asks you to grade a handful yourself, checks whether the levels
          really come apart in practice, and rewrites the ones that do not.
        </li>
        <li>
          <strong>It watches and keeps the record.</strong> It reads conversations as they
          happen, gives each one a score, applies whatever rule you set, and writes it all
          down.
        </li>
      </ul>

      <figure class="fig">
        <svg
          class="flow"
          viewBox="0 0 360 392"
          width="360"
          height="392"
          role="img"
          aria-label="Your app and Attune both run on your side. Your app sends Attune the conversation and gets back a score and whether your rule fired. Attune holds your signals, your examples and your record, which keeps scores and never message text. The only thing that crosses to the outside is the text you choose to score, sent to a model provider, which sends back the reading."
        >
          <defs>
            <marker id="at-arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path d="M0 0 L10 5 L0 10 z" fill="currentColor" />
            </marker>
            <marker id="at-arr-x" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
              <path class="x-fill" d="M0 0 L10 5 L0 10 z" fill="#2563eb" />
            </marker>
          </defs>

          <rect class="side" x="6" y="6" width="348" height="296" rx="12" fill="none" stroke="#858c97" stroke-dasharray="5 4" />
          <text class="t-sm t-mute" x="18" y="292">your side</text>

          <rect class="box" x="22" y="20" width="316" height="52" rx="8" fill="none" stroke="currentColor" />
          <text class="t-b" x="180" y="42" text-anchor="middle">Your app</text>
          <text class="t-sm t-mute" x="180" y="60" text-anchor="middle">decides what happens at each number</text>

          <line x1="130" y1="73" x2="130" y2="115" stroke="currentColor" marker-end="url(#at-arr)" />
          <text class="t-sm" x="122" y="98" text-anchor="end">the conversation</text>
          <line x1="250" y1="117" x2="250" y2="75" stroke="currentColor" marker-end="url(#at-arr)" />
          <text class="t-sm" x="258" y="98">3 · rule fired</text>

          <rect class="box" x="22" y="118" width="316" height="150" rx="8" fill="none" stroke="currentColor" stroke-width="1.5" />
          <text class="t-b" x="180" y="140" text-anchor="middle">Attune</text>
          <rect class="chip" x="38" y="152" width="134" height="28" rx="6" fill="none" stroke="#858c97" />
          <text class="t-sm" x="105" y="170" text-anchor="middle">your signals</text>
          <rect class="chip" x="188" y="152" width="134" height="28" rx="6" fill="none" stroke="#858c97" />
          <text class="t-sm" x="255" y="170" text-anchor="middle">your examples</text>
          <rect class="chip" x="38" y="190" width="284" height="64" rx="6" fill="none" stroke="#858c97" />
          <text class="t-sm t-b" x="180" y="210" text-anchor="middle">your record</text>
          <text class="t-sm" x="180" y="227" text-anchor="middle">score · every level · rule · model · time</text>
          <text class="t-sm t-mute" x="180" y="244" text-anchor="middle">no message text</text>

          <line class="x-line" x1="140" y1="269" x2="140" y2="333" stroke="#2563eb" stroke-width="1.5" marker-end="url(#at-arr-x)" />
          <text class="t-sm x-text" x="132" y="322" text-anchor="end" fill="#2563eb">the text to score</text>
          <line class="x-line" x1="220" y1="335" x2="220" y2="271" stroke="#2563eb" stroke-width="1.5" marker-end="url(#at-arr-x)" />
          <text class="t-sm x-text" x="228" y="322" fill="#2563eb">the reading</text>

          <rect class="box" x="80" y="336" width="200" height="48" rx="8" fill="none" stroke="currentColor" />
          <text class="t-b" x="180" y="356" text-anchor="middle">Model provider</text>
          <text class="t-sm t-mute" x="180" y="374" text-anchor="middle">the one hop that leaves</text>
        </svg>
        <figcaption>
          One honest limit: the text you choose to score leaves your side, on its way to the
          model that reads it. Everything else stays with you.
        </figcaption>
      </figure>

      <p>
        It installs as an MCP server or a command-line tool, so it fits into whatever you
        already run.
      </p>
    </section>

    <section class="at-sec">
      <h2>How it works</h2>
      <p>
        A signal is written down as a short list of levels, with one line saying what
        belongs in each. Here is distress:
      </p>
      <figure class="fig">
        <ol class="ld" aria-label="The distress signal, four levels">
          {LADDER.map((r) => (
            <>
              {r.level === ACT_ON && (
                <li class="ld-rule">↓ your rule: act on {ACT_ON} and above</li>
              )}
              <li class={r.level >= ACT_ON ? "ld-row ld-act" : "ld-row"}>
                <span class="ld-n">{r.level}</span>
                <div>
                  <code class="ld-line">{r.line}</code>
                  <p class="ld-ex">“{r.example}”</p>
                </div>
              </li>
            </>
          ))}
        </ol>
        <figcaption>
          Each example sits where the engine put it, and it put each one there three runs out
          of three (<span class="nw">{MODEL}</span>).
        </figcaption>
      </figure>
      <p>
        Every line there is sad. The feeling is the same at all four, and it tells you
        nothing. The number is what tells you whether to do something.
      </p>
      <p>
        Before you use a signal, {NAME} tests it on examples that a person has already
        graded. That test tells you whether your levels actually come apart, where to draw
        the line for acting, how much you miss if you draw it there, and whether the same
        sentence gets the same score twice. When a model changes, run it again and compare.
      </p>
      <p>
        The distress signal above is a second draft. In the first, line 2 said only “thoughts of
        death”, and one example kept landing on the fence:
      </p>

      <figure class="fig">
        <p class="fx-q">“{LADDER[1].example}”</p>
        <p class="fx-key" aria-hidden="true">
          <span><i class="sw sw-1"></i>level 1</span>
          <span><i class="sw sw-2"></i>level 2</span>
        </p>
        <div class="fx">
          {[
            { head: "First draft of line 2", runs: FIX.before, line: LINE2_V1, verdict: "A coin flip. Same sentence, different level." },
            { head: "Line 2, rewritten", runs: FIX.after, line: LADDER[1].line, verdict: "Level 2, three runs out of three." },
          ].map((panel, pi) => (
            <div class="fx-panel">
              <p class="fx-h">{panel.head}</p>
              {pi === 0 ? (
                <code class="fx-line">{panel.line}</code>
              ) : (
                <code class="fx-line">
                  thoughts of death <ins>or of not being here, including wishing to be gone</ins>; no plan,
                  no method, no timing
                </code>
              )}
              <ol class="fx-runs">
                {panel.runs.map((r, i) => (
                  <li>
                    <span class="fx-run">run {i + 1}</span>
                    <span class="fx-bar" aria-hidden="true">
                      {r[0] > 0 && <span class="fx-seg sw-1" style={`width:${r[0] * 100}%`} title={`Level 1: ${pct(r[0])}`}></span>}
                      {r[1] > 0 && <span class="fx-seg sw-2" style={`width:${r[1] * 100}%`} title={`Level 2: ${pct(r[1])}`}></span>}
                    </span>
                    <span class="fx-out">
                      → <strong>{winner(r)}</strong> <span class="fx-split">{pct(r[0])} / {pct(r[1])}</span>
                    </span>
                  </li>
                ))}
              </ol>
              <p class="fx-verdict">{panel.verdict}</p>
            </div>
          ))}
        </div>
        <figcaption>
          One rewritten line, and the coin stopped flipping. The other four examples did not
          move. Real runs on <span class="nw">{MODEL}</span>. Five sentences and one edit is a demonstration, not a
          test: a real signal is checked against many examples graded by people.
        </figcaption>
      </figure>
      <p>
        After that, every reading is saved: the score, how the rest of the levels ranked,
        the rule that fired, which model version read it, and when. Scores only — what your
        user wrote stays in your database.
      </p>
    </section>

    <section class="at-sec">
      <h2>Why a number and not a feeling word</h2>
      <p>
        “Sad” cannot be set as a limit, cannot be charted over three months, and cannot be
        shown to anyone as evidence. A number does all three.
      </p>
      <p>
        And the tools most apps reach for are good at one of those jobs and bad at the
        other. Measured in September 2026 on 516 posts graded by a psychiatrist, the usual
        moderation APIs scored <strong>0.86</strong> at spotting that something is wrong,
        and <strong>0.40</strong> at saying how bad it is. They shout at almost everything.
      </p>

      <figure class="fig">
        <div class="gp">
          {GAP.map((g) => (
            <div class="gp-row">
              <span class="gp-label">{g.task}</span>
              <span class="gp-track" aria-hidden="true">
                <span class="gp-fill" style={`width:${g.width * 100}%`} title={`${g.task}: ${g.score.toFixed(2)}`}></span>
              </span>
              <span class="gp-val">{g.score.toFixed(2)}</span>
            </div>
          ))}
          <p class="gp-axis" aria-hidden="true"><span>0</span><span>1 is perfect</span></p>
        </div>
        <figcaption>
          The usual moderation APIs, scored against a psychiatrist on 516 posts (F1, and
          macro-F1 across the four levels). Source: <a href="https://arxiv.org/abs/2609.06263">Beyond the Flag</a>, September 2026.
        </figcaption>
      </figure>
    </section>

    <section class="at-sec" id="ask">
      <h2>Who I am looking for</h2>
      <p>
        You ship a chatbot, an AI companion, a journaling or mood app, a support
        assistant — anything where people type to your software. And one of these is true:
      </p>
      <ul class="at-list">
        {WANT.map((w) => <li>{w}</li>)}
      </ul>
      <p class="at-early">
        Early access. I am working with the first few teams by hand, and building this
        around what they actually need.
      </p>
    </section>

    <footer class="at-foot">
      <p>
        <em>Attunement</em> is the word for reading how another person feels along with how
        strongly they feel it, rather than only its name. It is also what you do to an
        instrument before you trust what it reads.
      </p>
    </footer>
  </article>
</BaseLayout>

<script>
  // Tabs scroll the rail to a slide; the rail's own scrolling moves the highlight.
  // Without this script the rail still scrolls and every slide is still there.
  for (const car of document.querySelectorAll<HTMLElement>(".car")) {
    const rail = car.querySelector<HTMLElement>(".car-rail")!;
    const slides = [...rail.children] as HTMLElement[];
    const tabs = [...car.querySelectorAll<HTMLButtonElement>(".car-tab")];
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    car.classList.add("has-js");
    tabs.forEach((tab, i) =>
      tab.addEventListener("click", () =>
        rail.scrollTo({ left: slides[i].offsetLeft, behavior: still ? "auto" : "smooth" }),
      ),
    );
    const seen = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          const i = slides.indexOf(e.target as HTMLElement);
          tabs.forEach((t, j) => t.setAttribute("aria-current", String(i === j)));
        }
      },
      { root: rail, threshold: 0.6 },
    );
    slides.forEach((sl) => seen.observe(sl));
  }
</script>

<style>
  .at {
    max-width: 38rem;
    margin: 0 auto;
    line-height: 1.7;
  }
  .at-head h1 {
    margin-bottom: 0.2rem;
    letter-spacing: -0.02em;
  }
  .at-claim {
    font-size: 1.3rem;
    font-weight: 600;
    margin: 0 0 0.9rem;
  }
  .at-sub {
    font-size: 1.02rem;
    margin: 0 0 1.25rem;
  }
  .at-demo {
    border-left: 3px solid var(--accent);
    padding: 0.6rem 0 0.6rem 0.9rem;
    margin: 0 0 2.5rem;
    color: var(--muted);
