---
import BaseLayout from "../layouts/BaseLayout.astro";
import RandomColor from "../components/RandomColor.astro";
import Button from "../components/Button.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { groupProjects, toCardProps } from "../lib/projectGroups";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const sections = groupProjects(projects, { homeOnly: true });

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  width="wide"
  title="Dave — AI Evaluation & Reliability Consultant"
  description="I build and validate AI systems — turning 'it works in the demo' into evidence you can trust. Proven so far on document and financial AI extraction; the same approach applies wherever AI touches data that matters."
>
  <section class="hero">
    <h1>
      I build and validate <RandomColor>AI systems</RandomColor> you can trust.
    </h1>
    <p>
      Most AI systems look great in the demo and quietly drift once real data hits them — nobody notices until it costs something. I catch that: eval sets, accuracy benchmarks, confidence scoring, audit logs — the <RandomColor>evidence</RandomColor> that a system is doing what it claims. My deepest proof of this so far is in document and financial data extraction, but the same rigor works on any AI system handling data you can't afford to get wrong.
    </p>
  </section>

  {sections.map(({ group, items }) => (
    <section class="section">
      <SectionHeader title={group.label} note={group.note} />
      <div class="grid">
        {items.map((project) => <ProjectCard {...toCardProps(project)} />)}
      </div>
    </section>
  ))}

  <section class="section">
    <SectionHeader
      title="From the Blog"
      note="Benchmarks and teardowns — what broke, what it cost, and the number that settled it."
      href="/blog"
      linkLabel="All posts"
    />
    <div class="grid">
      {recentPosts.map((post) => (
        <ProjectCard
          href={`/blog/${post.slug}`}
          title={post.data.title}
          description={post.data.description}
          tags={post.data.tags}
          badge="Article"
        />
      ))}
    </div>
  </section>

  <p class="section-cta">
    <Button href="/projects">View all projects →</Button>
  </p>
</BaseLayout>
