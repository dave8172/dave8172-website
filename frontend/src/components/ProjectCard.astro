---
/**
 * The one card on this site. Home, /projects and /blog all render this, so
 * spacing, type scale and hover behaviour cannot drift between them.
 *
 * The whole card is clickable via an overlay on the title link, rather than by
 * wrapping everything in an <a> — that way the repo / PyPI / live-tool links in
 * the footer stay real links instead of illegal nested anchors. The footer sits
 * above the overlay on z-index; everything else sits under it.
 */
export interface CardLink {
  href: string;
  label: string;
  external?: boolean;
}

interface Props {
  href: string;
  title: string;
  description: string;
  tags?: string[];
  /** Small pill above the title, e.g. "Open source". */
  badge?: string;
  /** Drives the badge dot colour; falls back to a neutral dot. */
  kind?: "oss" | "tool" | "benchmark" | "automation";
  /** Appended to the badge line, e.g. "Python · MIT". */
  meta?: string;
  /** Monospace line under the description, e.g. an install command. */
  command?: string;
  links?: CardLink[];
}

const {
  href,
  title,
  description,
  tags = [],
  badge,
  kind,
  meta,
  command,
  links = [],
} = Astro.props as Props;
---

<article class:list={["project-card", kind && `kind-${kind}`]}>
  <div class="card-body">
    {badge && (
      <p class="card-badge">
        <span class="card-dot" aria-hidden="true"></span>{badge}{meta && <span class="card-meta"> · {meta}</span>}
      </p>
    )}

    <h3 class="card-title"><a href={href} class="card-link">{title}</a></h3>
    <p class="card-text">{description}</p>

    {command && <p class="card-command"><code>{command}</code></p>}

    {tags.length > 0 && (
      <ul class="tags">
        {tags.slice(0, 3).map((tag) => <li>{tag}</li>)}
      </ul>
    )}

    {links.length > 0 && (
      <div class="card-links">
        {links.map((link) => (
          <a
            href={link.href}
            class="card-action"
            target={link.external ? "_blank" : undefined}
            rel={link.external ? "noopener noreferrer" : undefined}
          >
            {link.label}<span aria-hidden="true">{link.external ? " ↗" : " →"}</span>
          </a>
        ))}
      </div>
    )}
  </div>
</article>
