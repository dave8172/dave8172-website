---
import RandomColor from "../components/RandomColor.astro";
import Analytics from "@vercel/analytics/astro";

// `width` lets a page opt into the wide grid container. MDX pages that use
// this file as their `layout` can set it in frontmatter; .astro pages pass it
// as a prop. Default stays the 720px reading column.
// `schema` lets a page replace the default Person block with its own JSON-LD.
// One <script type="application/ld+json"> per page, always — two graphs on one
// page is how you end up with two Person entities that disagree.
// `image` defaults to the site card, so a page that never thought about
// sharing still renders as a card rather than a bare URL. Blog and project
// pages pass their own and are unaffected.
const { title = "Dave", description = "", image = "/og.png", width = "prose", schema } = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = image ? new URL(image, Astro.site) : undefined;

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Dave",
  url: Astro.site,
  sameAs: ["https://github.com/dave8172", "https://x.com/dave8172"],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="color-scheme" content="light dark" />

    <link rel="icon" href="/favicons/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicons/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicons/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicons/favicon-16x16.png">

    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Dave" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonicalURL} />
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}

    <meta name="twitter:card" content={ogImageURL ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    <script type="application/ld+json" set:html={JSON.stringify(schema ?? personSchema)} />

    <link rel="stylesheet" href="/styles/global.css" />
    <Analytics />
  </head>
  <body>
    <header>
      <nav class="nav">
        <a href="/" class="brand">Dave</a>
        <div class="links">
          <a href="/about">About</a>
          <a href="/blog">Blog</a>
        </div>
      </nav>
    </header>

    <main class:list={["site-main", width === "wide" ? "layout-wide" : "prose"]}>
      <slot />
    </main>

    <footer class="footer">
      © {new Date().getFullYear()} <RandomColor>Dave</RandomColor>
    </footer>
  </body>
</html>
