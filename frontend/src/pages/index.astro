---
import BaseLayout from "../layouts/BaseLayout.astro";
import RandomColor from '../components/RandomColor.astro';
import Button from '../components/Button.astro';
import ProjectSlider from "../components/ProjectSlider.svelte";
import BlogSlider from "../components/BlogSlider.svelte";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
const allPosts = await getCollection("blog");

const featured = projects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const recentPosts = allPosts
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Dave — AI Reliability Audits" description="I audit and validate AI systems handling business-critical data — proving reliability with evidence, not claims. My entry point is document and financial AI extraction, backed by accuracy reports, audit logs, confidence scoring, and PII redaction.">
  <section>
    <h1>
      I audit <RandomColor>AI systems</RandomColor> you can trust.
    </h1>
    <p>
      Most AI pipelines look great in the demo and quietly drift once they hit real data — nobody notices until finance does. I check the work and hand you the receipts: accuracy reports, confidence scoring, audit logs, PII redaction. Right now that's mostly invoices, contracts, and financial documents — the data regulated businesses can't afford to get wrong.
    </p>
  </section>

  <section class="projects-section">
    <h2 style="margin-bottom: 0.5rem;"><RandomColor>Featured Projects</RandomColor></h2>

    <ProjectSlider projects={featured} client:load />

    <p style="margin-top: 1rem; text-align: center">
      <Button href="/projects">View all projects →</Button>
    </p>
  </section>

  <section class="projects-section">
    <h2 style="margin-bottom: 0.5rem;"><RandomColor>From the Blog</RandomColor></h2>

    <BlogSlider posts={recentPosts} client:load />

    <p style="margin-top: 1rem; text-align: center">
      <Button href="/blog">View all posts →</Button>
    </p>
  </section>

  <style>
    .projects-section {
      overflow-x: hidden;
      padding: 1rem 0;
    }
  </style>
</BaseLayout>
