---
import BaseLayout from "../layouts/BaseLayout.astro";
import RandomColor from "../components/RandomColor.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import { groupProjects, toCardProps } from "../lib/projectGroups";
import { getCollection } from "astro:content";

// Everything lives on this page now — there is no separate projects index.
const sections = groupProjects(await getCollection("projects"));

const recentPosts = (await getCollection("blog"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout
  width="wide"
  title="Dave"
  description="Open-source tooling, live tools you can run in the browser, accuracy benchmarks, and automation work."
>
  <section class="hero">
    <h1><RandomColor>Curious.</RandomColor></h1>
  </section>

  {sections.map(({ group, items }) => (
    <section class="section">
      <SectionHeader title={group.label} note={group.note} />
      <div class="grid">
        {items.map((project) => <ProjectCard {...toCardProps(project)} />)}
      </div>
    </section>
  ))}

  <section class="section">
    <SectionHeader
      title="From the Blog"
      note="Benchmarks and teardowns — what broke, what it cost, and the number that settled it."
      href="/blog"
      linkLabel="All posts"
    />
    <div class="grid">
      {recentPosts.map((post) => (
        <ProjectCard
          href={`/blog/${post.id}`}
          title={post.data.title}
          description={post.data.description}
          tags={post.data.tags}
          badge="Article"
        />
      ))}
    </div>
  </section>
</BaseLayout>
