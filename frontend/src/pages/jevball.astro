---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Magic Jev Ball"
  description="A Magic 8 Ball that actually reads the question. One call to Jev, a model that returns calibrated probabilities instead of text — and it shows you its working."
>
  <article class="jb">
    <header class="jb-head">
      <h1>Magic Jev Ball</h1>
      <p class="jb-sub">The old one was random. This one reads the question.</p>
    </header>

    <div class="jb-stage" id="jb-stage">
      <canvas id="jb-canvas" aria-hidden="true"></canvas>
      <div id="jb-window" class="jb-window">
        <span id="jb-face" class="jb-face jb-idle">JEV</span>
      </div>
    </div>

    <form id="jb-form" class="jb-ask" autocomplete="off">
      <label class="jb-sr" for="jb-q">Ask a question</label>
      <input id="jb-q" type="text" maxlength="400" placeholder="Ask anything…" enterkeyhint="go" />
      <button id="jb-go" type="submit">Shake</button>
    </form>

    <p id="jb-status" class="jb-status" role="status" aria-live="polite"></p>

    <section id="jb-detail" class="jb-detail" hidden>
      <button id="jb-toggle" class="jb-toggle" aria-expanded="false" aria-controls="jb-panel">
        <span class="jb-chev" aria-hidden="true">▸</span> What the ball actually said
      </button>
      <div id="jb-panel" class="jb-panel" hidden>
        <div class="jb-row">
          <span class="jb-k">Verdict</span>
          <span><strong id="jb-score">—</strong> <span class="jb-muted">on a 0–4 axis</span></span>
        </div>
        <div class="jb-meter" id="jb-meter" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((i) => <div class="jb-cell" data-cell={i}><i></i></div>)}
        </div>
        <ul class="jb-legend" id="jb-legend">
          {[0, 1, 2, 3, 4].map((i) => <li data-row={i}></li>)}
        </ul>
        <div class="jb-row">
          <span class="jb-k">Confidence</span>
          <span><strong id="jb-conf">—</strong> <span class="jb-muted" id="jb-conf-note"></span></span>
        </div>
        <div class="jb-row"><span class="jb-k">Is a real question</span><span id="jb-isq">—</span></div>
        <div class="jb-row"><span class="jb-k">Knowable at all</span><span id="jb-know">—</span></div>
        <div class="jb-row"><span class="jb-k">Stakes</span><span id="jb-stakes">—</span></div>
        <p class="jb-foot" id="jb-explain"></p>
      </div>
    </section>

    <p class="jb-credit">
      One call to <a href="https://docs.typesafe.ai" rel="noopener">Jev</a> carries four questions:
      a Score for the verdict, and Nouls for whether it is a real question and whether anyone
      could know. Jev picks the bucket; the wording is chosen in code.
    </p>
  </article>
</BaseLayout>

<style>
  /* Self-contained retro panel. It keeps its paper identity inside the site's
     own light and dark themes rather than inheriting either — a physical
     object sitting on the page. */
  .jb {
    --paper: #f2efe6;
    --ink: #16150f;
    --dim: #7a7566;
    --hot: #c8502d;
    max-width: 34rem;
    margin: 0 auto;
    padding: 28px 20px 32px;
    background: var(--paper);
    color: var(--ink);
    border: 2px solid var(--ink);
    background-image: radial-gradient(rgba(22, 21, 15, 0.035) 1px, transparent 1px);
    background-size: 4px 4px;
    font-family: ui-monospace, "SF Mono", Menlo, Consolas, "Courier New", monospace;
    font-size: 15px;
    line-height: 1.5;
  }

  @media (prefers-color-scheme: dark) {
    .jb {
      --paper: #17161200;
      --ink: #e8e3d5;
      --dim: #8d8775;
      background: #171612;
      background-image: radial-gradient(rgba(232, 227, 213, 0.04) 1px, transparent 1px);
      border-color: #3a362c;
    }
  }

  .jb-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .jb-head { text-align: center; margin-bottom: 22px; }

  .jb h1 {
    margin: 0; font-size: clamp(1.35rem, 6vw, 1.9rem);
    letter-spacing: 0.22em; text-transform: uppercase; font-weight: 700;
    font-family: inherit; color: var(--ink);
  }

  .jb-sub { margin: 10px 0 0; color: var(--dim); font-size: 0.78rem; }

  .jb-stage { position: relative; width: min(280px, 76vw); aspect-ratio: 1; margin: 0 auto 24px; }
  #jb-canvas { display: block; width: 100%; height: 100%; }
  /* No WebGL: the stage paints the ball itself and nothing else changes. */
  .jb-stage.flat { background: radial-gradient(circle at 36% 30%, #3a3a3a 0%, #111 55%, #000 100%); border-radius: 50%; }

  .jb-window {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
    width: 35%; aspect-ratio: 1; border-radius: 50%;
    background: #f2efe6; color: #16150f; border: 2px solid #0b0b0b;
    display: grid; place-items: center; padding: 7%; text-align: center;
    transition: opacity 0.28s ease;
  }
  .jb-window.hidden { opacity: 0; }

  .jb-face {
    font-size: clamp(0.5rem, 2.1vw, 0.62rem); line-height: 1.2;
    letter-spacing: 0.06em; text-transform: uppercase; font-weight: 700;
    overflow-wrap: anywhere;
  }
  .jb-face.jb-idle { font-size: clamp(0.95rem, 4.4vw, 1.25rem); letter-spacing: 0.1em; }

  .jb-ask { display: flex; gap: 8px; margin-bottom: 10px; }

  #jb-q {
    flex: 1 1 auto; min-width: 0; padding: 11px 13px;
    /* 16px or mobile Safari zooms the viewport on focus. */
    font-family: inherit; font-size: 16px;
    color: var(--ink); background: transparent;
    border: 2px solid var(--ink); border-radius: 0; appearance: none;
  }
  #jb-q::placeholder { color: var(--dim); }

  .jb button {
    padding: 11px 17px; font-family: inherit; font-size: 0.82rem; font-weight: 700;
    letter-spacing: 0.12em; text-transform: uppercase;
    color: var(--paper); background: var(--ink);
    border: 2px solid var(--ink); border-radius: 0; cursor: pointer;
  }
  @media (prefers-color-scheme: dark) { .jb button { color: #171612; } }
  .jb button:disabled { opacity: 0.45; cursor: default; }
  #jb-q:focus-visible, .jb button:focus-visible { outline: 2px solid var(--hot); outline-offset: 2px; }

  .jb-status { min-height: 1.2em; margin: 0 0 16px; font-size: 0.76rem; color: var(--hot); text-align: center; }

  .jb-detail { border-top: 2px solid var(--ink); padding-top: 12px; }
  .jb-toggle {
    width: 100%; text-align: left; background: none !important; color: var(--ink) !important;
    border: 0 !important; padding: 4px 0; font-size: 0.72rem; letter-spacing: 0.08em;
  }
  .jb-chev { display: inline-block; transition: transform 0.2s ease; }
  .jb-toggle[aria-expanded="true"] .jb-chev { transform: rotate(90deg); }

  .jb-panel { padding-top: 10px; }
  .jb-row {
    display: flex; justify-content: space-between; align-items: baseline; gap: 12px;
    padding: 7px 0; border-bottom: 1px dotted var(--dim); font-size: 0.76rem;
  }
  .jb-k { color: var(--dim); }
  .jb-muted { color: var(--dim); font-size: 0.7rem; }

  .jb-meter { display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; margin: 12px 0 8px; }
  .jb-cell { position: relative; height: 30px; border: 1px solid var(--ink); overflow: hidden; }
  .jb-cell i { position: absolute; left: 0; right: 0; bottom: 0; display: block; background: var(--ink); }
  .jb-cell.at i { background: var(--hot); }

  .jb-legend { list-style: none; margin: 0 0 6px; padding: 0; font-size: 0.68rem; color: var(--dim); }
  .jb-legend li { padding: 2px 0; }
  .jb-legend li.at { color: var(--hot); }

  .jb-foot { margin: 12px 0 0; font-size: 0.68rem; color: var(--dim); line-height: 1.6; }
  .jb-credit { margin: 22px auto 0; max-width: 34rem; font-size: 0.72rem; color: var(--muted); text-align: center; }
</style>

<!-- three.js must define THREE before ball.js runs. -->
<script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/0.160.0/three.min.js" is:inline></script>
<script src="/jevball-ball.js" is:inline></script>
<script is:inline>
  (function () {
    var form = document.getElementById("jb-form");
    var input = document.getElementById("jb-q");
    var go = document.getElementById("jb-go");
    var stage = document.getElementById("jb-stage");
    var win = document.getElementById("jb-window");
    var face = document.getElementById("jb-face");
    var status = document.getElementById("jb-status");
    var detail = document.getElementById("jb-detail");
    var toggle = document.getElementById("jb-toggle");
    var panel = document.getElementById("jb-panel");

    var LEVELS = ["Almost certainly not", "Probably not", "Could go either way", "Probably yes", "Almost certainly yes"];

    if (!window.Ball || !Ball.init(document.getElementById("jb-canvas"))) stage.classList.add("flat");

    toggle.addEventListener("click", function () {
      var open = toggle.getAttribute("aria-expanded") === "true";
      toggle.setAttribute("aria-expanded", String(!open));
      panel.hidden = open;
    });

    function pct(x) { return Math.round(x * 100) + "%"; }

    function render(r) {
      var v = r.verdict;
      document.getElementById("jb-score").textContent = v.score.toFixed(2);
      document.getElementById("jb-conf").textContent = v.confidence.toFixed(2);

      // Confidence is how peaked the distribution is, not how sure the ball is
      // of a yes. A sharp "could go either way" reads 0.98 — the single most
      // misread number on this page, so it gets said out loud.
      document.getElementById("jb-conf-note").textContent = "— " + (v.confidence >= 0.8
        ? (r.level === 2 ? "sharply undecided" : "the levels separated cleanly")
        : "the levels blurred into each other");

      document.getElementById("jb-isq").textContent = pct(r.signals.isQuestion);
      document.getElementById("jb-know").textContent = pct(r.signals.knowable);
      document.getElementById("jb-stakes").textContent = r.signals.stakes.toFixed(2) + " / 2.00";

      for (var i = 0; i < 5; i++) {
        var p = v.probabilities[String(i)] || 0;
        var cell = document.querySelector('[data-cell="' + i + '"]');
        cell.classList.toggle("at", i === r.level);
        cell.querySelector("i").style.height = Math.max(p * 100, p > 0 ? 2 : 0) + "%";

        var li = document.querySelector('[data-row="' + i + '"]');
        li.classList.toggle("at", i === r.level);
        li.textContent = i + " \u00b7 " + LEVELS[i] + " — " + pct(p);
      }

      document.getElementById("jb-explain").textContent = r.reason === "not_a_question"
        ? "That did not read as a question, so the ball did not bother scoring it."
        : r.reason === "unknowable"
          ? "The ball landed on the middle and rated the answer genuinely unknowable — so it said so rather than stalling."
          : "Jev chose the level. Which of that level's phrasings you got was chosen in code, seeded on your question — ask the same thing again and the ball says the same thing.";

      detail.hidden = false;
    }

    form.addEventListener("submit", function (e) {
      e.preventDefault();
      var q = input.value.trim();
      if (!q) { input.focus(); return; }

      go.disabled = true;
      status.textContent = "";
      win.classList.add("hidden");
      var wait = (window.Ball && Ball.shake()) || 0;

      fetch("/api/jev", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ question: q })
      })
        .then(function (res) {
          return res.json().then(function (body) {
            if (!res.ok) throw new Error(body.error || "The ball clouded over.");
            return body;
          });
        })
        .then(function (r) {
          // Never reveal before the tumble finishes, however fast the API was.
          setTimeout(function () {
            face.textContent = r.answer;
            face.classList.remove("jb-idle");
            win.classList.remove("hidden");
            render(r);
            go.disabled = false;
          }, Math.max(0, wait - 120));
        })
        .catch(function (err) {
          setTimeout(function () {
            face.textContent = "JEV";
            face.classList.add("jb-idle");
            win.classList.remove("hidden");
            status.textContent = err.message || "Something went wrong.";
            go.disabled = false;
          }, Math.max(0, wait - 120));
        });
    });
  })();
</script>
