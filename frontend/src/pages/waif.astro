---
import BaseLayout from "../layouts/BaseLayout.astro";
import { AXES, AXIS_IDS, INTENTS, SPEC, EVAL, EVAL_N, ROUNDTRIP, FAMILIES, SOURCE } from "../lib/waif";

const AXIS_LIST = AXIS_IDS.map((id) => ({ id, ...AXES[id] }));
/** A correction names a shade; the family it belongs to follows from it. */
const SHADE_FAMILY = Object.fromEntries(
  FAMILIES.flatMap((f) => f.shades.map((sh) => [sh.word, f.id])),
);
const INTENT_LIST = (Object.keys(INTENTS) as (keyof typeof INTENTS)[]).map((k) => ({ id: k, ...INTENTS[k] }));


const EXAMPLES = [
  ["blocked", "I have asked them four times for the file and they keep saying tomorrow. Now it is my deadline that slips."],
  ["flat", "woke up. worked. ate something. went back to bed. nothing happened today and nothing will tomorrow either."],
  ["a kindness", "She drove three hours in the rain just to sit with me for an afternoon. I did not even ask her to."],
  ["asking", "Is there any chance you could look at this before Monday? I am stuck and I do not know who else to ask."],
];
---

<BaseLayout
  title="waif — what am I feeling?"
  description="Paste something you wrote and waif reads the feeling behind it, and what you are doing with it. Measured on three axes anchored to published human norms, named by a model in two stages, with every number and the whole method on the page."
>
  <article class="wf">
    <header class="wf-head">
      <h1>waif</h1>
      <p class="wf-say">What am I feeling?</p>
      <p class="wf-sub">
        Write something — a message you have not sent, a note to yourself, anything.
        You get the feeling, what you are doing with it, and every number behind it.
      </p>
    </header>

    <form id="wf-form" class="wf-ask" autocomplete="off">
      <label class="wf-sr" for="wf-text">Something you wrote</label>
      <textarea id="wf-text" rows="5" maxlength="1200"
                placeholder="However it actually came out…"></textarea>
      <div class="wf-bar">
        <span class="wf-count" id="wf-count" aria-hidden="true"></span>
        <button id="wf-go" type="submit">Read it</button>
      </div>
    </form>

    <div class="wf-eg">
      <span class="wf-eg-k">or try</span>
      {EXAMPLES.map(([label, text]) => (
        <button type="button" class="wf-chip" data-eg={text}>{label}</button>
      ))}
    </div>

    <p id="wf-status" class="wf-status" role="status" aria-live="polite"></p>

    <section id="wf-out" class="wf-out" hidden aria-live="polite">
      <p class="wf-fam" id="wf-fam"></p>
      <p class="wf-word" id="wf-word">—</p>
      <p class="wf-gloss" id="wf-gloss"></p>
      <p class="wf-sentence" id="wf-sentence"></p>

      <ul class="wf-notes" id="wf-notes"></ul>

      <div class="wf-axes">
        {AXIS_LIST.map((ax) => (
          <div class="wf-ax" data-ax={ax.id}>
            <div class="wf-ax-top">
              <span class="wf-ax-name">{ax.label}</span>
              <span class="wf-ax-read"><b data-role="read">—</b><span class="wf-ax-num" data-role="num"></span></span>
            </div>
            <div class="wf-ax-bars" aria-hidden="true">
              {[0, 1, 2, 3, 4].map((i) => <span class="wf-cell" data-cell={i}><i></i></span>)}
            </div>
            <div class="wf-ax-ends">
              <span>{ax.ends[0]}</span>
              <span>{ax.ends[1]}</span>
            </div>
          </div>
        ))}
      </div>

      <div class="wf-fb" id="wf-fb" hidden>
        <p class="wf-fb-q">Does that fit?</p>
        <div class="wf-fb-row" id="wf-fb-ask">
          <button type="button" class="wf-chip" id="wf-fb-yes">Yes, that is it</button>
          <button type="button" class="wf-chip" id="wf-fb-no">Not quite</button>
        </div>
        <div class="wf-fb-form" id="wf-fb-form" hidden>
          <label class="wf-fb-l" for="wf-fb-shade">What would you call it?</label>
          <select id="wf-fb-shade">
            <option value="">— leave blank if you are not sure —</option>
            {FAMILIES.map((f) => (
              <optgroup label={f.label}>
                {f.shades.map((sh) => <option value={sh.word}>{sh.word}</option>)}
              </optgroup>
            ))}
            <option value="__other">— none of these; let me type it —</option>
          </select>
          <input
            id="wf-fb-other"
            class="wf-fb-other"
            type="text"
            maxlength="40"
            autocomplete="off"
            placeholder="your word for it"
            hidden
          />
          <label class="wf-fb-l" for="wf-fb-intent">And what were you doing?</label>
          <select id="wf-fb-intent">
            <option value="">— leave blank if you are not sure —</option>
            {INTENT_LIST.map((i) => <option value={i.id}>{i.label}</option>)}
          </select>
          <div class="wf-fb-row">
            <button type="button" id="wf-fb-send">Send</button>
          </div>
        </div>
        <p class="wf-fb-done" id="wf-fb-done" hidden></p>
        <p class="wf-fb-note">
          A correction sends the reading's numbers and the word you picked — including which
          words were offered, so a word that beat two of them counts differently from a word
          that beat one. It does not send what you wrote, which is never stored anywhere.
          A word that is not in the sixty-two is the most useful correction there is: it says
          the vocabulary is missing something, which no amount of rewording fixes.
        </p>
      </div>

      <div class="wf-detail">
        <button id="wf-toggle" class="wf-toggle" aria-expanded="false" aria-controls="wf-panel">
          <span class="wf-chev" aria-hidden="true">▸</span> What Jev actually said
        </button>
        <div id="wf-panel" class="wf-panel" hidden>
          <p class="wf-note">
            Every question it was asked, every option it could have picked, and where it put
            the probability.
          </p>
          <div id="wf-qbs"></div>
        </div>
      </div>

    </section>

    <p class="wf-teams">
      Building this as a component other software can call — a scale you define, validated
      before you use it, and a log of every reading. <a href="/attune">Attune</a>, and what
      I am trying to find out about it.
    </p>

    <div class="wf-how">
      <p class="wf-how-sub">
        The three axes, why the name is two questions asked at once, when it comes back as two
        words, what the published ratings can and cannot do, and what a correction does.
      </p>
      <div class="wf-detail">
        <button id="wf-toggle2" class="wf-toggle" aria-expanded="false" aria-controls="wf-panel2">
          <span class="wf-chev" aria-hidden="true">▸</span> How it works, and what a correction does
        </button>
        <div id="wf-panel2" class="wf-panel wf-prose" hidden>
          <h3>Seven answers, three jobs</h3>
          <p>
            They do not all do the same thing, and only two of them choose the word.
          </p>
          <table class="wf-eval wf-roles">
            <tbody>
              <tr><td>Family, then shade</td><td><strong>The word.</strong> Nothing else picks it</td></tr>
              <tr><td>Valence, arousal, control</td><td>The sentence, and the three meters</td></tr>
              <tr><td>Intent</td><td>The end of that sentence</td></tr>
              <tr><td>Is this writing at all</td><td>A gate — below 0.50 nothing is scored</td></tr>
            </tbody>
          </table>
          <p>
            The axes used to pick the word too. The scores further down are why they no
            longer do.
          </p>

          <h3>Three axes</h3>
          <p>
            Valence (pleasant ↔ unpleasant), arousal (shut down ↔ keyed up) and control
            (powerless ↔ in charge), measured separately because they vary separately. Each
            level is anchored to words whose ratings were measured, so <em>as activated as rage
            or panic</em>{" "}is a claim you can check where <em>very aroused</em>{" "}is not.
          </p>

          <h3>Two questions, asked at the same time</h3>
          <p>
            Naming the feeling is two decisions, not one. Which family is it in — anger, fear,
            sadness, shame? And which shade of that family exactly? Families are genuinely
            alternatives to one another, and once a family is settled its shades are a short
            list of near neighbours rather than sixty-two strangers.
          </p>
          <p>
            <strong>Neither is asked second.</strong> All eleven shade questions go out in the
            same request as the family question, each one assuming its own family — <em>if this
            is anger, which anger?</em>{" "}— and the code keeps the answer whose assumption
            turned out to hold. The other ten are thrown away. That is worth doing because the
            model reads your text once and answers every question against it at the same time,
            so ten wasted questions cost almost nothing, while waiting to hear which one to ask
            costs a whole round trip. Measured over {ROUNDTRIP.sameFamily} readings:{" "}
            <strong>{ROUNDTRIP.fanout.ms}ms</strong> against{" "}
            <strong>{ROUNDTRIP.sequential.ms}ms</strong> when it was two requests, faster on{" "}
            {ROUNDTRIP.faster} of {ROUNDTRIP.faster} head-to-head pairs, and naming the same
            family every time. It <em>was</em>{" "}two requests, for a day.
          </p>
          <p>
            The split was originally argued for on the grounds that one Choice over sixty-two
            near-synonyms would divide its own vote between wordings. Measured, it does not:
            one Choice scores 44 against this design's 43 on the same 46 readings, and is
            slightly the more certain of the two. What the split actually buys is <strong>two
            separate doubts</strong>. <em>Is this sadness or affection</em>{" "}is a different
            failure from <em>it is clearly shame, but guilt or embarrassment</em>, and the page
            says different things in each case; one Choice returns a single number that cannot
            tell them apart.
          </p>
          <h3>Sometimes the answer is two words</h3>
          <p>
            A text can be genuinely between guilt and embarrassment. When it is, the shade
            question does not fail — it returns 52% and 41%, and that split <em>is</em>{" "}the
            reading. Picking one of them and printing it in large type would be the failure.
          </p>
          <p>
            So two words get named, stronger first, when both of these hold: the top word did
            not settle on its own (below 0.60), <strong>and</strong>{" "}the two of them hold
            80% or more of the weight between them. Both conditions earn their place. Without
            the first, every clean reading would be paired with whatever came second at 3%.
            Without the second, a text spread thinly across <em>guilt</em>, <em>regret</em>{" "}
            and <em>shame</em>{" "}would be reported as two when it is really none — that one
            keeps a single word and says plainly that it did not settle. On the probe set the
            rule fires on 5 texts in 23.
          </p>
          <p>
            <em>Or more</em>{" "}is load-bearing, and it took a bug to notice.{" "}
            <strong>Every probability this model returns is a whole hundredth</strong>{" "}— 6,796
            of them checked, not one otherwise — so a top-two sum does not approach 80%, it
            lands on it. The <em>flat</em>{" "}example above does exactly that: apathy 46% plus
            emptiness 34%, which a rule reading <em>more than</em>{" "}dropped while the page
            showed the two numbers adding to 80. On a scale that moves in steps, a threshold has
            to say which side the step itself falls on.
          </p>
          <p>
            What you are <em>doing</em>{" "}is a separate question again: a choice over eight
            speech acts, which are alternatives to one another in the way emotion words are not.
          </p>

          <h3>The ratings are reference, not the mechanism</h3>
          <p>
            Every word below carries published human ratings of valence, arousal and dominance.
            Using those numbers to <strong>pick</strong>{" "}the word was tried, and scored on
            24 texts against a list of acceptable answers for each:
          </p>
          <table class="wf-eval">
            <tbody>
              {EVAL.map((e) => (
                <tr>
                  <td>{e.design}</td>
                  <td><strong>{e.score}/{EVAL_N}</strong></td>
                </tr>
              ))}
            </tbody>
          </table>
          <p>
            They fail for three reasons. Dominance correlates with valence at <strong>+0.87</strong>{" "}
            across these words, so the third number is nearly a copy of the first. Negative
            emotions occupy a very small part of the space, so the nearest one is close to
            arbitrary. And a word rated on its own is not the same measurement as writing read in
            context — people rate the word <em>gratitude</em>{" "}far more activated than a
            grateful message reads. So the ratings anchor the rubric and show where each word
            sits. The model does the naming.
          </p>

          <h3>What happens when you correct it</h3>
          <p>
            Every reading asks whether it fits. Saying no sends the numbers above and the word
            you would have used — <strong>never what you wrote</strong>, which a correction does
            not need and which is stored nowhere.
          </p>
          <p>
            That does not retrain anything. The model is hosted and has no learning surface, so
            a correction changes nothing by itself. What the corrections build is the thing the
            table above is made of: <strong>a labelled set of real readings</strong>, growing,
            with an accept rate attached.
          </p>
          <p>
            Which is where the loop closes. A shade corrected the same way twenty times is not
            bad luck, it is one line of the rubric describing the wrong thing — and that line can
            be rewritten and scored again the same afternoon, against the same probe set. The
            learning is real; it just happens in the wording rather than in the weights.
          </p>
          <p>
            <strong>A correction records what it beat.</strong> When two words were named, both
            travel with it, because <em>guilt was wrong</em>{" "}and <em>neither guilt nor
            embarrassment was right</em>{" "}are different complaints and want different fixes.
            And if none of the sixty-two is the word, you can type your own — that one is sent
            with no family attached, which is how it gets counted separately. It is the most
            useful correction there is: it says the vocabulary is short a word, and no amount of
            rewriting an existing gloss can answer it.
          </p>
          <p>
            One thing it deliberately will not do is move on a single answer. A feeling is not
            something anyone is objectively right about, and one person disagreeing is data, not
            a verdict. Only a correction that <em>repeats</em>{" "}says anything about the wording.
          </p>

          <h3>What it cannot do</h3>
          <p>
            Sixty-two words and no more, and no coordinate separates feelings that differ only by
            what caused them. Where the shade does not separate it names the two words it is
            between; where even the family is unsettled, it says so.
          </p>

          <div class="wf-scroll">
            <table class="wf-words">
              <thead>
                <tr><th>Word</th><th>Valence</th><th>Arousal</th><th>Dominance</th><th>n</th><th>sd</th></tr>
              </thead>
              <tbody>
                {FAMILIES.map((f) => (
                  <>
                    <tr class="wf-famrow" data-famrow={f.id}>
                      <td colspan="6">{f.label} — {f.gloss}</td>
                    </tr>
                    {f.shades.map((sh) => (
                      <tr data-word={sh.word}>
                        <td>{sh.word}<span class="wf-q">{sh.gloss}</span></td>
                        <td>{sh.v.toFixed(2)}</td>
                        <td>{sh.a.toFixed(2)}</td>
                        <td>{sh.d.toFixed(2)}</td>
                        <td>{sh.n}</td>
                        <td>{sh.sd.toFixed(2)}</td>
                      </tr>
                    ))}
                  </>
                ))}
              </tbody>
            </table>
          </div>
          <p class="wf-note">
            Ratings on a 1–9 scale, from{" "}
            <a href={SOURCE.doi} rel="noopener">{SOURCE.cite}</a>. <em>n</em>{" "}is how many
            people rated the word and <em>sd</em>{" "}the spread of their valence scores, which
            is rarely small.
          </p>
        </div>
      </div>
    </div>

    <footer class="wf-foot">
      <p>
        One call to <a href="https://docs.typesafe.ai" rel="noopener">Jev</a>, a model that returns
        calibrated probabilities instead of text. It measures the three axes, picks the family and
        the intent, and answers a shade question for every family at once — the one whose family
        won is the word above, or the two words above where it landed on two. Gibberish is
        refused rather than scored.
      </p>
      <p>Nothing you type is stored or logged — it goes to the model to be scored, and that is all.</p>
      <p class="wf-care">
        If you are having a hard time, <a href="https://findahelpline.com" rel="noopener">findahelpline.com</a>&nbsp;lists
        free, confidential support in most countries. This page is an instrument, not help.
      </p>
    </footer>
  </article>
</BaseLayout>

<style is:global>
  /*
    waif is light, always. The site follows the reader's system theme
    everywhere else; this one page opts out, because the point is a surface
    that is quiet to sit with while you look at something you wrote.
    `html[lang]` rather than `:root` so these win over the dark-mode tokens in
    global.css by specificity, whatever order the two arrive in.
  */
  html[lang] {
    color-scheme: light;
    --bg: #f5f3f9;
    --text: #2f2b3a;
    --muted: #7d7790;
    --border: #e7e2f0;
    --accent: #6f63ab;
    --card-bg: #ffffff;
  }
  html[lang] body {
    background: linear-gradient(170deg, #f6f3fa 0%, #f3f6f7 100%) fixed;
    color: var(--text);
  }
</style>

<style>
  /*
    Calm is mostly geometry: long line-height, soft corners, and one accent used
    sparingly enough that it still means something. Pastel on the surfaces and
    deliberately NOT pastel on the data — a bar the same lightness as its
    background cannot be read, and three pastel hues for three axes failed
    colourblind separation outright (teal against terracotta, ΔE 3.9 for
    protanopia). So hue carries nothing: every axis uses the same accent, and
    which level is selected is said in words beside the bars as well as in colour.
  */
  .wf {
    --ink: #2f2b3a;
    --soft: #56506b;
    --dim: #8b85a0;
    --line: #e9e5f2;
    --accent: #6f63ab;
    --track: #efecf6;
    --rest: rgba(47, 43, 58, 0.24);
    --card: #ffffff;

    max-width: 36rem;
    margin: 0 auto;
    color: var(--ink);
    font-size: 17px;
    line-height: 1.7;
    font-variant-numeric: tabular-nums;
  }

  .wf-sr {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0;
  }

  .wf-head { text-align: center; margin-bottom: 30px; }
  .wf h1 {
    margin: 0; font-size: 1.5rem; font-weight: 600; letter-spacing: 0.18em;
    text-transform: lowercase; color: var(--accent);
  }
  .wf-say {
    margin: 10px 0 0; font-family: Georgia, "Iowan Old Style", serif;
    font-size: clamp(1.5rem, 6vw, 2.1rem); line-height: 1.25; color: var(--ink);
  }
  .wf-sub { margin: 14px auto 0; max-width: 30rem; color: var(--soft); font-size: 0.98rem; }

  .wf-ask { margin: 0; }
  #wf-text {
    width: 100%; box-sizing: border-box; padding: 16px 18px;
    font-family: inherit; font-size: 16px; line-height: 1.7; color: var(--ink);
    background: var(--card); border: 1px solid var(--line); border-radius: 14px;
    resize: vertical; appearance: none;
    box-shadow: 0 1px 2px rgba(47, 43, 58, 0.04);
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  #wf-text::placeholder { color: var(--dim); }
  #wf-text:focus {
    outline: none; border-color: var(--accent);
    box-shadow: 0 0 0 4px rgba(111, 99, 171, 0.12);
  }

  .wf-bar { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 12px; }
  .wf-count { font-size: 0.8rem; color: var(--dim); }

  .wf button {
    font-family: inherit; font-size: 0.95rem; font-weight: 600; cursor: pointer;
    padding: 11px 22px; color: #fff; background: var(--accent);
    border: 1px solid var(--accent); border-radius: 999px;
    transition: opacity 0.2s ease, transform 0.12s ease;
  }
  .wf button:hover:not(:disabled) { opacity: 0.9; }
  .wf button:active:not(:disabled) { transform: translateY(1px); }
  .wf button:disabled { opacity: 0.45; cursor: default; }
  .wf button:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }

  .wf-eg { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 16px; }
  .wf-eg-k { font-size: 0.82rem; color: var(--dim); }
  .wf-chip {
    padding: 5px 13px !important; font-size: 0.82rem !important; font-weight: 500 !important;
    color: var(--soft) !important; background: var(--card) !important;
    border: 1px solid var(--line) !important;
  }
  .wf-chip:hover { border-color: var(--accent) !important; color: var(--accent) !important; }

  .wf-status { min-height: 1.3em; margin: 16px 0 0; font-size: 0.9rem; color: #9a5a4e; }

  .wf-out {
    margin-top: 26px; padding: 26px 24px 22px;
    background: var(--card); border: 1px solid var(--line); border-radius: 18px;
    box-shadow: 0 2px 10px rgba(47, 43, 58, 0.05);
  }
  .wf-fam {
    margin: 0 0 6px; font-size: 0.74rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--dim);
  }
  .wf-word {
    margin: 0; font-family: Georgia, "Iowan Old Style", serif;
    font-size: clamp(2rem, 9vw, 2.9rem); line-height: 1.1; color: var(--accent);
  }
  .wf-and, .wf-w2 { opacity: 0.5; }
  .wf-gloss { margin: 6px 0 0; font-size: 0.95rem; color: var(--dim); font-style: italic; }
  .wf-sentence { margin: 14px 0 0; font-size: 1.05rem; color: var(--ink); }


  .wf-notes { list-style: none; margin: 16px 0 0; padding: 0; }
  .wf-notes :global(li) {
    padding: 7px 0 7px 16px; font-size: 0.92rem; color: var(--soft);
    border-left: 2px solid var(--line);
  }

  .wf-axes { margin-top: 26px; display: grid; gap: 22px; }
  .wf-ax-top { display: flex; justify-content: space-between; align-items: baseline; gap: 10px; }
  .wf-ax-name { font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--dim); }
  /* The direct label. Identity is never carried by the accent alone. */
  .wf-ax-read { font-size: 0.95rem; color: var(--ink); font-weight: 600; }
  .wf-ax-num { color: var(--dim); font-weight: 400; font-size: 0.88rem; }

  /* Five cells, one per level, each as tall as its probability, with a 2px gap
     so adjacent fills never merge into one block. */
  .wf-ax-bars { display: grid; grid-template-columns: repeat(5, 1fr); gap: 2px; margin: 9px 0 7px; }
  .wf-cell { position: relative; height: 46px; background: var(--track); border-radius: 5px; overflow: hidden; }
  .wf-cell i {
    position: absolute; left: 0; right: 0; bottom: 0; display: block;
    background: var(--rest); border-radius: 4px 4px 0 0;
    transition: height 0.5s cubic-bezier(0.22, 0.61, 0.36, 1);
  }
  .wf-cell.at i { background: var(--accent); }

  .wf-ax-ends { display: flex; justify-content: space-between; gap: 10px; font-size: 0.78rem; color: var(--dim); }

  /* The ask sits between the reading and the panels: after the thing being
     judged, before the machinery, and quiet enough to ignore. */
  .wf-fb { margin-top: 24px; padding-top: 18px; border-top: 1px solid var(--line); }
  .wf-fb-q { margin: 0 0 10px; font-size: 0.92rem; color: var(--ink); }
  .wf-fb-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .wf-fb-form { margin-top: 14px; display: grid; gap: 6px; }
  /* `display: flex`/`grid` above outrank the UA stylesheet's
     [hidden] { display: none }, so a hidden block stays on screen — which put
     the correction form under every reading before anyone asked for it. */
  .wf-fb-row[hidden], .wf-fb-form[hidden] { display: none; }
  .wf-fb-l { font-size: 0.8rem; color: var(--dim); margin-top: 6px; }
  .wf-fb select {
    width: 100%; padding: 9px 11px; font-family: inherit; font-size: 15px;
    color: var(--ink); background: var(--card); border: 1px solid var(--line);
    border-radius: 10px; appearance: none;
  }
  .wf-fb select:focus { outline: none; border-color: var(--accent); }
  .wf-fb-done { margin: 10px 0 0; font-size: 0.9rem; color: var(--accent); }
  .wf-fb-other {
    width: 100%; margin-top: 8px; padding: 9px 11px;
    font: inherit; font-size: 0.92rem; color: var(--ink);
    background: var(--card); border: 1px solid var(--line); border-radius: 8px;
  }
  .wf-fb-other:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
  .wf-fb-note { margin: 12px 0 0; font-size: 0.78rem; color: var(--dim); }

  /* Always on the page, reading or no reading. It carries the card's surface so
     it does not read as an orphan below the form. */
  .wf-teams {
    max-width: 36rem;
    margin: 2rem auto 0;
    padding: 0.85rem 1rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    color: var(--soft);
    font-size: 0.92rem;
    line-height: 1.6;
  }

  .wf-how {
    margin-top: 24px; padding: 8px 24px 14px;
    background: var(--card); border: 1px solid var(--line); border-radius: 18px;
    box-shadow: 0 2px 10px rgba(47, 43, 58, 0.05);
  }
  .wf-how .wf-detail { margin-top: 0; border-top: 0; }
  /* Collapsed, this card was one low-contrast line that read as a divider.
     The summary is what tells a reader there is anything inside it. */
  .wf-how-sub {
    margin: 4px 0 0; padding: 8px 0 0; order: 2;
    font-size: 0.82rem; line-height: 1.6; color: var(--dim);
    border-top: 1px solid var(--line);
  }
  .wf-how { display: flex; flex-direction: column; }
  .wf-how .wf-detail { order: 1; }
  /* Once it is open the summary is just a repeat of the headings below it. */
  .wf-how:has(.wf-toggle[aria-expanded="true"]) .wf-how-sub { display: none; }

  .wf-detail { margin-top: 22px; border-top: 1px solid var(--line); padding-top: 4px; }
  .wf-toggle {
    width: 100%; text-align: left !important; padding: 8px 0 !important;
    background: none !important; color: var(--soft) !important; border: 0 !important;
    font-size: 0.88rem !important; font-weight: 500 !important;
  }
  .wf-chev { display: inline-block; transition: transform 0.2s ease; color: var(--accent); }
  .wf-toggle[aria-expanded="true"] .wf-chev { transform: rotate(90deg); }

  .wf-panel { padding-top: 6px; overflow-x: auto; }
  .wf-tbl { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
  .wf-tbl th {
    text-align: left; font-weight: 500; color: var(--dim); padding: 6px 10px 6px 0;
    border-bottom: 1px solid var(--line); white-space: nowrap;
  }
  .wf-tbl :global(td) { padding: 8px 10px 8px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .wf-tbl :global(td:first-child) { color: var(--ink); }
  .wf-tbl :global(.wf-q) { color: var(--dim); font-size: 0.8rem; display: block; max-width: 24rem; }
  .wf-tbl :global(.wf-num) { color: var(--accent); font-weight: 600; }
  .wf-tbl :global(.wf-spread) { color: var(--soft); font-size: 0.8rem; }

  #wf-qbs :global(.wf-qb) { padding: 16px 0; border-bottom: 1px solid var(--line); }
  #wf-qbs :global(.wf-qb:last-child) { border-bottom: 0; padding-bottom: 0; }
  #wf-qbs :global(.wf-qb-head) {
    display: flex; justify-content: space-between; gap: 12px; align-items: baseline;
    flex-wrap: wrap;
  }
  #wf-qbs :global(.wf-qb-name) {
    font-size: 0.74rem; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink);
  }
  #wf-qbs :global(.wf-qb-type) { font-size: 0.78rem; color: var(--dim); }
  #wf-qbs :global(.wf-qb-q) { margin: 6px 0 4px; font-size: 0.86rem; color: var(--soft); }
  #wf-qbs :global(.wf-qb-role) {
    margin: 0 0 10px; font-size: 0.78rem; color: var(--accent);
    padding-left: 10px; border-left: 2px solid var(--track);
  }
  #wf-qbs :global(.wf-opts) { list-style: none; margin: 0; padding: 0; display: grid; gap: 3px; }
  /* The bar is the row's own background, so a long option still reads as text
     and the probability is legible on top of it rather than beside a sliver. */
  #wf-qbs :global(.wf-opt) {
    display: flex; justify-content: space-between; gap: 14px; padding: 7px 10px;
    font-size: 0.82rem; line-height: 1.5; color: var(--soft); border-radius: 6px;
    background: linear-gradient(to right, var(--track) var(--p), transparent var(--p));
  }
  #wf-qbs :global(.wf-opt.at) {
    color: var(--ink); font-weight: 600;
    background: linear-gradient(to right, rgba(111, 99, 171, 0.22) var(--p), transparent var(--p));
  }
  #wf-qbs :global(.wf-opt-p) { color: var(--dim); font-weight: 400; white-space: nowrap; }
  #wf-qbs :global(.wf-opt.at .wf-opt-p) { color: var(--accent); font-weight: 600; }

  .wf-note { margin: 14px 0 0; font-size: 0.84rem; color: var(--dim); }
  .wf-note strong { color: var(--soft); }
  .wf-note a { color: var(--accent); }

  /* The vocabulary table is numeric and six columns wide, so it scrolls rather
     than restacking — a coordinate split across two lines stops being one. */
  .wf-scroll { margin-top: 14px; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .wf-words { border-collapse: collapse; font-size: 0.82rem; min-width: 100%; }
  .wf-words th {
    text-align: right; font-weight: 500; color: var(--dim); white-space: nowrap;
    padding: 5px 0 5px 14px; border-bottom: 1px solid var(--line);
  }
  .wf-words th:first-child { text-align: left; padding-left: 0; }
  .wf-words td {
    text-align: right; padding: 6px 0 6px 14px; border-bottom: 1px solid var(--line);
    color: var(--soft); white-space: nowrap;
  }
  .wf-words td:first-child { text-align: left; padding-left: 0; color: var(--ink); white-space: normal; }
  .wf-words .wf-q {
    display: block; white-space: normal; max-width: 18rem;
    font-size: 0.78rem; color: var(--dim); font-weight: 400;
  }
  .wf-words tr.at td { color: var(--accent); font-weight: 600; }
  .wf-words tr.at .wf-q { color: var(--accent); font-weight: 400; }
  .wf-famrow td {
    padding-top: 18px; color: var(--dim); font-size: 0.74rem;
    letter-spacing: 0.1em; text-transform: uppercase; border-bottom: 0; text-align: left;
  }
  .wf-famrow.at td { color: var(--accent); }

  .wf-prose { font-size: 0.92rem; color: var(--soft); }
  .wf-prose h3 {
    margin: 22px 0 8px; font-size: 0.78rem; letter-spacing: 0.14em;
    text-transform: uppercase; color: var(--dim); font-weight: 600;
  }
  .wf-prose h3:first-child { margin-top: 10px; }
  .wf-prose p { margin: 0 0 12px; }
  .wf-prose strong { color: var(--ink); }
  .wf-eval { width: 100%; border-collapse: collapse; font-size: 0.86rem; margin: 4px 0 16px; }
  .wf-eval td { padding: 8px 0; border-bottom: 1px solid var(--line); vertical-align: top; }
  .wf-eval td:last-child { text-align: right; white-space: nowrap; padding-left: 14px; color: var(--accent); }
  .wf-roles td { vertical-align: top; }
  .wf-roles td:last-child { white-space: normal; text-align: right; }

  .wf-foot { margin: 28px auto 0; font-size: 0.85rem; line-height: 1.75; color: var(--dim); }
  .wf-foot p { margin: 0 0 10px; }
  .wf-foot a { color: var(--accent); }
  .wf-care { padding-top: 10px; border-top: 1px solid var(--line); }

  @media (max-width: 480px) {
    .wf-out { padding: 22px 18px 18px; border-radius: 16px; }
    .wf-how { padding: 6px 18px 12px; border-radius: 16px; }
    .wf-ax-ends { font-size: 0.72rem; }
    .wf-ax-top { flex-wrap: wrap; }
  }

  /* Four columns inside a phone gives one word per line and a column of
     fragments. Below this width the raw-answers table stops being a table. */
  @media (max-width: 560px) {
    .wf-panel { overflow-x: visible; }
    .wf-tbl, .wf-tbl :global(tbody) { display: block; }
    .wf-tbl thead { display: none; }
    .wf-tbl :global(tr) {
      display: grid; grid-template-columns: 1fr auto; gap: 3px 12px;
      padding: 13px 0; border-bottom: 1px solid var(--line);
    }
    .wf-tbl :global(td) { padding: 0; border: 0; }
    .wf-tbl :global(td:nth-child(1)) { grid-column: 1 / -1; }
    .wf-tbl :global(td:nth-child(2)) { color: var(--dim); font-size: 0.78rem; }
    .wf-tbl :global(td:nth-child(3)) { text-align: right; }
    .wf-tbl :global(td:nth-child(4)) { grid-column: 1 / -1; color: var(--dim); font-size: 0.78rem; }
    .wf-tbl :global(td:nth-child(4))::before { content: "confidence "; }
    .wf-tbl :global(td:nth-child(4):has(.wf-noconf)) { display: none; }
    .wf-tbl :global(.wf-q) { max-width: none; }
  }
</style>

<script is:inline define:vars={{ AXIS_LIST, SPEC, SHADE_FAMILY }}>
  (function () {
    var form = document.getElementById("wf-form");
    var text = document.getElementById("wf-text");
    var go = document.getElementById("wf-go");
    var count = document.getElementById("wf-count");
    var status = document.getElementById("wf-status");
    var out = document.getElementById("wf-out");

    var MAX = 1200;
    var SHORT = {};
    AXIS_LIST.forEach(function (a) { SHORT[a.id] = a.short; });

    function pct(x) { return Math.round(x * 100) + "%"; }

    function updateCount() {
      var n = text.value.length;
      count.textContent = n > MAX - 200 ? n + " / " + MAX : "";
    }
    text.addEventListener("input", updateCount);

    function wireToggle(id, bodyId) {
      var btn = document.getElementById(id), body = document.getElementById(bodyId);
      btn.addEventListener("click", function () {
        var open = btn.getAttribute("aria-expanded") === "true";
        btn.setAttribute("aria-expanded", String(!open));
        body.hidden = open;
      });
    }
    wireToggle("wf-toggle", "wf-panel");
    wireToggle("wf-toggle2", "wf-panel2");

    document.querySelectorAll(".wf-chip").forEach(function (chip) {
      chip.addEventListener("click", function () {
        text.value = chip.getAttribute("data-eg");
        updateCount();
        text.focus();
        ask();
      });
    });

    function paintAxis(id, a) {
      var root = document.querySelector('[data-ax="' + id + '"]');
      root.querySelector('[data-role="read"]').textContent = SHORT[id][a.level];
      root.querySelector('[data-role="num"]').textContent =
        " · " + a.score.toFixed(2) + (a.unsure ? " · unsettled" : "");
      for (var i = 0; i < 5; i++) {
        var cell = root.querySelector('[data-cell="' + i + '"]');
        cell.classList.toggle("at", i === a.level);
        var p = a.probabilities[i] || 0;
        // A level with weight but no height reads as zero, so anything
        // non-zero keeps a visible sliver.
        cell.querySelector("i").style.height = (p > 0 ? Math.max(p * 100, 3) : 0) + "%";
      }
    }

    // Backticks are how the question points at the state field; they are
    // noise to anyone reading the question itself.
    function plain(q) {
      // The backticks point the question at the state field. Stripping them
      // leaves "text is something a person wrote", which reads as a fragment,
      // so the field name becomes an article and the sentence gets its capital.
      var t = q.replace(/`text`/g, "the text").replace(/`/g, "");
      return t.charAt(0).toUpperCase() + t.slice(1);
    }

    function opts(options, probs, chosen) {
      var marked = chosen == null ? [] : [].concat(chosen);
      return options.map(function (o) {
        var p = probs[o.key] || 0;
        return '<li class="wf-opt' + (marked.indexOf(o.key) > -1 ? " at" : "") +
          '" style="--p:' + (p * 100).toFixed(1) + '%"><span>' + o.text +
          '</span><span class="wf-opt-p">' + Math.round(p * 100) + "%</span></li>";
      }).join("");
    }

    function block(label, type, question, role, body) {
      var d = document.createElement("div");
      d.className = "wf-qb";
      d.innerHTML =
        '<div class="wf-qb-head"><span class="wf-qb-name">' + label +
        '</span><span class="wf-qb-type">' + type + "</span></div>" +
        '<p class="wf-qb-q">' + plain(question) + "</p>" +
        '<p class="wf-qb-role">' + role + "</p>" +
        '<ul class="wf-opts">' + body + "</ul>";
      return d;
    }

    function render(r) {
      document.getElementById("wf-fam").textContent =
        r.family.label + " · " + pct(r.family.confidence) + " sure of the family";
      // One word, or two when the weight sits on two of them. The second is
      // dimmed rather than dropped: the order is the reading, so it has to be
      // visible that one came first.
      var wordEl = document.getElementById("wf-word");
      wordEl.textContent = "";
      (r.words.length ? r.words : [{ word: r.word, gloss: r.gloss }]).forEach(function (w, i) {
        if (i) {
          var and = document.createElement("span");
          and.className = "wf-and";
          and.textContent = " and ";
          wordEl.appendChild(and);
        }
        var sp = document.createElement("span");
        if (i) sp.className = "wf-w2";
        sp.textContent = i ? w.word : w.word.charAt(0).toUpperCase() + w.word.slice(1);
        wordEl.appendChild(sp);
      });
      document.getElementById("wf-gloss").textContent =
        r.words.length > 1 ? r.words.map(function (w) { return w.gloss; }).join(" · ") : r.gloss;
      document.getElementById("wf-sentence").textContent = r.sentence;

      var notes = document.getElementById("wf-notes");
      notes.innerHTML = "";
      r.notes.forEach(function (n) {
        var li = document.createElement("li");
        li.textContent = n;
        notes.appendChild(li);
      });

      AXIS_LIST.forEach(function (a) { paintAxis(a.id, r.axes[a.id]); });

      var qbs = document.getElementById("wf-qbs");
      qbs.innerHTML = "";

      SPEC.scores.forEach(function (q) {
        var ax = r.axes[q.id];
        var probs = {};
        ax.probabilities.forEach(function (p, i) { probs[String(i)] = p; });
        qbs.appendChild(block(q.label, "Score · confidence " + ax.confidence.toFixed(2),
          q.question, q.role, opts(q.options, probs, String(ax.level))));
      });

      qbs.appendChild(block("Family", "Choice · confidence " + r.family.confidence.toFixed(2),
        SPEC.family.question, SPEC.family.role,
        opts(SPEC.family.options, r.distributions.family, r.family.id)));

      var sh = SPEC.shades[r.family.id];
      if (sh) {
        var named = r.words.map(function (w) { return w.word; });
        qbs.appendChild(block("Shade", "Choice, 1 of 11 asked · confidence " + r.shadeConfidence.toFixed(2),
          sh.question, sh.role, opts(sh.options, r.distributions.shade, named)));
      }

      qbs.appendChild(block("Intent", "Choice · confidence " + r.intent.confidence.toFixed(2),
        SPEC.intent.question, SPEC.intent.role,
        opts(SPEC.intent.options, r.distributions.intent, r.intent.id)));

      SPEC.nouls.forEach(function (q) {
        var v = r.isWriting;
        qbs.appendChild(block(q.label, "Noul", q.question, q.role,
          opts([{ key: "yes", text: "yes" }, { key: "no", text: "no" }],
               { yes: v, no: 1 - v }, null)));
      });

      // Mark the chosen word and its family in the vocabulary table.
      document.querySelectorAll(".wf-words tr.at").forEach(function (tr) { tr.classList.remove("at"); });
      (r.words.length ? r.words.map(function (w) { return w.word; }) : [r.word.toLowerCase()])
        .forEach(function (w) {
          var wr = document.querySelector('[data-word="' + w + '"]');
          if (wr) wr.classList.add("at");
        });
      var fr = document.querySelector('[data-famrow="' + r.family.id + '"]');
      if (fr) fr.classList.add("at");

      out.hidden = false;
    }

    // --- feedback -----------------------------------------------------------
    var fb = document.getElementById("wf-fb");
    var fbAsk = document.getElementById("wf-fb-ask");
    var fbForm = document.getElementById("wf-fb-form");
    var fbDone = document.getElementById("wf-fb-done");
    var fbShade = document.getElementById("wf-fb-shade");
    var fbOther = document.getElementById("wf-fb-other");
    var fbIntent = document.getElementById("wf-fb-intent");
    var current = null;

    function resetFeedback(r) {
      current = r && r.feedback ? r : null;
      fb.hidden = !current;
      fbAsk.hidden = false;
      fbForm.hidden = true;
      fbDone.hidden = true;
      fbShade.value = "";
      fbOther.value = "";
      fbOther.hidden = true;
      fbIntent.value = "";
    }

    // A word outside the sixty-two is a real answer, and the one the vocabulary
    // cannot give you. It is sent with no family, which is how the read-back
    // tells "this gloss is wrong" apart from "this word is missing".
    fbShade.addEventListener("change", function () {
      fbOther.hidden = fbShade.value !== "__other";
      if (!fbOther.hidden) fbOther.focus();
    });

    function sendFeedback(fits, extra) {
      if (!current) return;
      fbAsk.hidden = true;
      fbForm.hidden = true;
      fbDone.hidden = false;
      fbDone.textContent = "Sending…";
      var body = Object.assign({}, current.judgment, { token: current.token, fits: fits }, extra || {});
      fetch("/api/waif/feedback", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(body),
      })
        .then(function (res) { return res.json().then(function (b) { if (!res.ok) throw new Error(b.error); return b; }); })
        .then(function () {
          fbDone.textContent = fits
            ? "Thank you — logged."
            : "Thank you — logged. Corrections are what the wording gets rewritten from.";
        })
        .catch(function (err) { fbDone.textContent = err.message || "That did not save."; });
    }

    document.getElementById("wf-fb-yes").addEventListener("click", function () { sendFeedback(true); });
    document.getElementById("wf-fb-no").addEventListener("click", function () {
      fbAsk.hidden = true;
      fbForm.hidden = false;
      fbShade.focus();
    });
    document.getElementById("wf-fb-send").addEventListener("click", function () {
      var picked = fbShade.value;
      var own = picked === "__other";
      var shade = own ? fbOther.value.trim().slice(0, 40).toLowerCase() : picked;
      sendFeedback(false, {
        trueShade: shade || undefined,
        trueFamily: shade && !own ? SHADE_FAMILY[shade] : undefined,
        trueIntent: fbIntent.value || undefined,
      });
    });

    var busy = false;

    function ask() {
      if (busy) return;
      var value = text.value.trim();
      if (!value) {
        text.focus();
        status.textContent = "Write something first.";
        return;
      }
      busy = true;
      go.disabled = true;
      status.textContent = "Reading…";

      fetch("/api/waif", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ text: value }),
      })
        .then(function (res) {
          return res.json().then(function (body) {
            if (!res.ok) throw new Error(body.error || "That did not come back.");
            return body;
          });
        })
        .then(function (r) {
          status.textContent = "";
          if (!r.ok) {
            out.hidden = true;
            resetFeedback(null);
            status.textContent = "That did not read as something a person wrote, so it was not scored.";
            return;
          }
          render(r);
          resetFeedback(r);
        })
        .catch(function (err) { status.textContent = err.message || "Something went wrong."; })
        .finally(function () { busy = false; go.disabled = false; });
    }

    form.addEventListener("submit", function (e) { e.preventDefault(); ask(); });
    // Enter sends; a newline needs a modifier, since most of what people paste
    // here is one or two lines and the button is a long way down on a phone.
    text.addEventListener("keydown", function (e) {
      if (e.key === "Enter" && (e.metaKey || e.ctrlKey)) { e.preventDefault(); ask(); }
    });
  })();
</script>
