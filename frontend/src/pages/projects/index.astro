---
import BaseLayout from "../../layouts/BaseLayout.astro";
import RandomColor from "../../components/RandomColor.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import SectionHeader from "../../components/SectionHeader.astro";
import { groupProjects, toCardProps } from "../../lib/projectGroups";
import { getCollection } from "astro:content";

const sections = groupProjects(await getCollection("projects"));
---

<BaseLayout
  width="wide"
  title="Projects — Dave"
  description="Open-source eval tooling, live document tools, accuracy benchmarks, and the automation and integration work underneath them."
>
  <header class="page-header">
    <h1><RandomColor>Projects</RandomColor></h1>
    <p class="page-intro">
      Open source first, because it is the only work here you can check line by line. Then the tools you can run, the benchmarks behind the claims, and the client builds the rest of it grew out of.
    </p>
  </header>

  {sections.map(({ group, items }) => (
    <section class="section">
      <SectionHeader title={group.label} note={group.note} />
      <div class="grid">
        {items.map((project) => <ProjectCard {...toCardProps(project)} />)}
      </div>
    </section>
  ))}
</BaseLayout>
